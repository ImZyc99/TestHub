{
  "name": "testhub",
  "version": "0.2.0",
  "private": true,
  "description": "多模型并行对话客户端 —— 一个提示词，同时发给多个模型窗口",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight-pack.mjs",
    "dist:mac": "npm run preflight && npm run build && electron-builder --mac",
    "dist:win": "npm run preflight && npm run build && electron-builder --win",
    "dist:linux": "npm run preflight && npm run build && electron-builder --linux",
    "dist:check": "npm run preflight && npm run build && electron-builder --dir",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "highlight.js": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.testhub.app",
    "productName": "TestHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/config.json",
      "!**/secrets.json",
      "!**/datadir.json",
      "!**/*.log",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}